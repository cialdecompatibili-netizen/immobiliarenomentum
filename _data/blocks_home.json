[
    {
        "id": "hero",
        "nome": "Hero",
        "enabled": true,
        "html": "<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\"><link href=\"https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@500;600;700&family=Inter:wght@400;500;600&display=swap\" rel=\"stylesheet\">\n<style>\n#main-content{--ink:#14202e;--navy:#0f2a43;--line:#e4e6ea;--warm:#f6f5f2;--muted:#4f5865;--d:'Cormorant Garamond',Georgia,serif;--b:'Inter','Helvetica Neue',Arial,sans-serif;--ease:cubic-bezier(.16,1,.3,1);font-family:var(--b)}\n.nm-btn{display:inline-flex;align-items:center;justify-content:center;min-height:48px;padding:.8rem 1.7rem;font-family:var(--b);font-weight:600;font-size:.95rem;letter-spacing:.04em;text-transform:uppercase;border-radius:0;text-decoration:none;border:1px solid transparent;transition:background-color .2s var(--ease),color .2s var(--ease)}\n.nm-btn:focus-visible{outline:3px solid var(--ink);outline-offset:3px}\n.nm-btn-n{background:var(--navy);color:#fff}.nm-btn-n:hover{background:#1d4468;color:#fff}\n.nm-btn-o{border-color:var(--navy);color:var(--navy)}.nm-btn-o:hover{background:var(--navy);color:#fff}\n.nm-btn-w{background:#fff;color:var(--navy)}.nm-btn-w:hover{background:#e9eef3}\n.nm-sec{padding:clamp(3.5rem,8vw,6.5rem) 1.5rem;background:#fff}.nm-warm{background:var(--warm)}\n.nm-wrap{max-width:1180px;margin:0 auto}\n.nm-eye{font-size:.8rem;font-weight:600;letter-spacing:.18em;text-transform:uppercase;color:var(--muted);margin:0 0 .9rem}\n.nm-h2{font-family:var(--d);font-weight:600;font-size:clamp(2.1rem,3.6vw,3.2rem);line-height:1.08;color:var(--ink);margin:0;text-wrap:balance}\n.nm-lead{font-size:1.08rem;line-height:1.7;color:var(--muted);max-width:52ch;margin:1.1rem 0 0}\n.nm-hero{position:relative;overflow:hidden;background:var(--navy);color:#fff;display:flex;align-items:center;min-height:min(86svh,760px)}\n.nm-hero-bg,.nm-hero-bg img{position:absolute;inset:0;width:100%;height:100%;display:block}.nm-hero-bg img{object-fit:cover;object-position:50% 55%}\n.nm-hero::after{content:\"\";position:absolute;inset:0;background:linear-gradient(90deg,rgba(8,24,40,.82) 0%,rgba(8,24,40,.55) 50%,rgba(8,24,40,.15) 100%)}\n.nm-hero-in{position:relative;z-index:1;width:100%;max-width:1180px;margin:0 auto;padding:clamp(3.5rem,9vw,7rem) 1.5rem}\n.nm-hero h1{font-family:var(--d);font-weight:600;font-size:clamp(2.6rem,6vw,5rem);line-height:1.02;color:#fff;margin:0 0 1.2rem;max-width:16ch;text-wrap:balance}\n.nm-hero p{font-size:clamp(1rem,1.2vw,1.2rem);line-height:1.65;color:#eaf0f5;max-width:50ch;margin:0 0 2rem}\n.nm-search{display:flex;flex-wrap:wrap;gap:.75rem}\n.nm-hero .nm-btn-o{border-color:#fff;color:#fff}.nm-hero .nm-btn-o:hover{background:#fff;color:var(--navy)}\n.nm-num{background:#fff;border-bottom:1px solid var(--line)}\n.nm-num ul{max-width:1180px;margin:0 auto;padding:2rem 1.5rem;list-style:none;display:grid;grid-template-columns:repeat(4,1fr);gap:1.5rem}\n.nm-num li{margin:0;text-align:center}.nm-num b{display:block;font-family:var(--d);font-size:clamp(2rem,3.4vw,2.8rem);font-weight:600;color:var(--navy);line-height:1}.nm-num span{display:block;margin-top:.4rem;font-size:.9rem;color:var(--muted)}\n.nm-head{display:flex;justify-content:space-between;align-items:flex-end;gap:2rem;flex-wrap:wrap;margin-bottom:2.5rem}\n.nm-cards{display:grid;grid-template-columns:repeat(3,1fr);gap:1.75rem}\n.nm-card{background:#fff;border:1px solid var(--line);display:block;text-decoration:none;color:inherit}\n.nm-ph{display:block;width:100%;aspect-ratio:4/3;object-fit:cover;background:#dfe4ea}\n.nm-card-b{padding:1.25rem 1.3rem 1.5rem}.nm-tag{display:inline-block;font-size:.72rem;font-weight:600;letter-spacing:.14em;text-transform:uppercase;color:var(--muted);margin-bottom:.5rem}\n.nm-card h3{font-family:var(--d);font-size:1.55rem;font-weight:600;margin:0 0 .35rem;color:var(--ink);line-height:1.15}.nm-card p{margin:0;color:var(--muted);line-height:1.55;font-size:.98rem}\n.nm-meta{display:flex;gap:1.1rem;margin:.9rem 0 0;padding:.9rem 0 0;border-top:1px solid var(--line);list-style:none;font-size:.9rem;color:var(--ink)}.nm-meta li{margin:0}\n.nm-price{font-family:var(--d);font-weight:700;font-size:1.35rem;color:var(--navy);margin-top:.6rem;display:block}\n.nm-svcs{display:grid;grid-template-columns:repeat(3,1fr);gap:0;border-top:1px solid var(--ink)}\n.nm-svc{padding:1.6rem 1.5rem 1.7rem 0;border-bottom:1px solid var(--line)}\n.nm-svc h3{font-family:var(--d);font-size:1.5rem;font-weight:600;color:var(--ink);margin:0 0 .4rem;line-height:1.15}.nm-svc p{margin:0;color:var(--muted);line-height:1.6;font-size:.98rem}\n.nm-2col{display:grid;grid-template-columns:1fr 1.15fr;gap:clamp(2rem,5vw,4.5rem);align-items:center}\n.nm-img{width:100%;height:clamp(260px,34vw,440px);object-fit:cover;display:block;background:#dfe4ea}\n.nm-list{list-style:none;margin:1.5rem 0 0;padding:0}.nm-list li{padding:.8rem 0;border-top:1px solid var(--line);color:var(--muted);line-height:1.55;margin:0}.nm-list li:last-child{border-bottom:1px solid var(--line)}.nm-list b{color:var(--ink);font-weight:600}\n.nm-steps{display:grid;grid-template-columns:repeat(4,1fr);gap:2rem;margin-top:3rem;counter-reset:s;list-style:none;padding:0}\n.nm-steps li{counter-increment:s;border-top:1px solid var(--ink);padding-top:1rem;margin:0}.nm-steps li::before{content:\"0\" counter(s);font-family:var(--d);font-size:1.9rem;color:var(--navy);display:block;margin-bottom:.3rem}\n.nm-steps b{display:block;font-family:var(--d);font-size:1.35rem;font-weight:600;color:var(--ink);margin-bottom:.3rem}.nm-steps span{color:var(--muted);line-height:1.6;font-size:.98rem}\n.nm-zone{display:flex;flex-wrap:wrap;gap:.6rem;margin-top:2rem}.nm-zone span{padding:.55rem 1.1rem;border:1px solid var(--line);background:#fff;color:var(--ink);font-size:.95rem}\n.nm-cta{background:var(--navy);padding:clamp(3rem,6vw,4.5rem) 1.5rem}.nm-cta-in{max-width:1180px;margin:0 auto;display:flex;justify-content:space-between;align-items:center;gap:2rem;flex-wrap:wrap}\n.nm-cta .nm-h2{color:#fff}.nm-cta p{margin:.6rem 0 0;color:#d5dee8;font-size:1.05rem;line-height:1.6}\n.nm-bar{display:none}\n@media(max-width:900px){.nm-hero::after{background:linear-gradient(180deg,rgba(8,24,40,.45) 0%,rgba(8,24,40,.85) 100%)}.nm-num ul{grid-template-columns:1fr 1fr}.nm-cards,.nm-svcs{grid-template-columns:1fr 1fr}.nm-2col{grid-template-columns:1fr}.nm-steps{grid-template-columns:1fr 1fr}}\n@media(max-width:600px){.nm-cards,.nm-svcs,.nm-steps{grid-template-columns:1fr}.nm-sec,.nm-cta{padding-left:1.25rem;padding-right:1.25rem}.nm-bar{display:block;position:fixed;left:0;right:0;bottom:0;z-index:50;padding:.6rem 1rem;background:#fff;border-top:1px solid var(--line)}.nm-bar a{width:100%;box-sizing:border-box}body{padding-bottom:4.5rem}}\n</style>\n<header class=\"nm-hero\" aria-label=\"Presentazione\"><picture class=\"nm-hero-bg\"><img src=\"__BASEURL__/assets/foto/agenzia/hero-villa.jpg\" width=\"2200\" height=\"1467\" fetchpriority=\"high\" decoding=\"async\" alt=\"Villa moderna con piscina\"></picture><div class=\"nm-hero-in\"><h1>Quanto vale la tua casa? Scoprilo gratis.</h1><p>Compravendita, locazioni e consulenza sul mutuo a Mentana, Monterotondo e Roma nord. Un solo referente dalla prima visita al rogito.</p><div class=\"nm-search\"><a class=\"nm-btn nm-btn-w\" href=\"#immobili\">Compra</a><a class=\"nm-btn nm-btn-o\" href=\"#immobili\">Affitta</a><a class=\"nm-btn nm-btn-o\" href=\"__BASEURL__/vendi/\">Valuta la tua casa</a></div></div></header>\n<script>(function(){var m=document.querySelector(\".nv-header,.masthead\"),r=document.documentElement;function s(){if(m)r.style.setProperty(\"--mh\",Math.round(m.getBoundingClientRect().height)+\"px\")}s();if(window.ResizeObserver&&m)new ResizeObserver(s).observe(m);window.addEventListener(\"resize\",s);window.addEventListener(\"load\",s)})()</script>"
    },
    {
        "id": "numeri",
        "nome": "Numeri",
        "enabled": true,
        "html": "<section class=\"nm-num\" aria-label=\"Nomentum in numeri\"><ul><li><b>00</b><span>anni di attività</span></li><li><b>000</b><span>immobili venduti</span></li><li><b>0,0</b><span>mesi tempo medio di vendita</span></li><li><b>00</b><span>consulenti</span></li></ul></section>"
    },
    {
        "id": "immobili",
        "nome": "Immobili in evidenza",
        "enabled": true,
        "html": "<section class=\"nm-sec\" id=\"immobili\" aria-labelledby=\"imm-t\"><div class=\"nm-wrap\"><div class=\"nm-head\"><div><p class=\"nm-eye\">Immobili</p><h2 class=\"nm-h2\" id=\"imm-t\">Selezione in evidenza</h2></div><a class=\"nm-btn nm-btn-o\" href=\"__BASEURL__/contatti/\">Richiedi la ricerca su misura</a></div><div class=\"nm-cards\"><a class=\"nm-card\" href=\"__BASEURL__/contatti/\"><img class=\"nm-ph\" src=\"__BASEURL__/assets/foto/agenzia/villa-piscina.jpg\" width=\"800\" height=\"600\" loading=\"lazy\" alt=\"Villa con piscina\"><div class=\"nm-card-b\"><span class=\"nm-tag\">In vendita</span><h3>Appartamento con giardino</h3><p>Mentana, zona residenziale</p><ul class=\"nm-meta\"><li>000 m&sup2;</li><li>0 locali</li><li>0 bagni</li></ul><span class=\"nm-price\">Prezzo su richiesta</span></div></a><a class=\"nm-card\" href=\"__BASEURL__/contatti/\"><img class=\"nm-ph\" src=\"__BASEURL__/assets/foto/agenzia/casa-giardino.jpg\" width=\"800\" height=\"600\" loading=\"lazy\" alt=\"Casa moderna con giardino\"><div class=\"nm-card-b\"><span class=\"nm-tag\">In vendita</span><h3>Villa indipendente</h3><p>Monterotondo</p><ul class=\"nm-meta\"><li>000 m&sup2;</li><li>0 locali</li><li>0 bagni</li></ul><span class=\"nm-price\">Prezzo su richiesta</span></div></a><a class=\"nm-card\" href=\"__BASEURL__/contatti/\"><img class=\"nm-ph\" src=\"__BASEURL__/assets/foto/agenzia/appartamento.jpg\" width=\"800\" height=\"600\" loading=\"lazy\" alt=\"Appartamento luminoso\"><div class=\"nm-card-b\"><span class=\"nm-tag\">In affitto</span><h3>Trilocale arredato</h3><p>Roma nord</p><ul class=\"nm-meta\"><li>00 m&sup2;</li><li>0 locali</li><li>0 bagni</li></ul><span class=\"nm-price\">Prezzo su richiesta</span></div></a></div><p class=\"nm-lead\">Schede di esempio: foto, prezzi e dati reali saranno inseriti con i primi immobili in portafoglio.</p></div></section>"
    },
    {
        "id": "servizi",
        "nome": "Servizi",
        "enabled": true,
        "html": "<section class=\"nm-sec nm-warm\" id=\"servizi\" aria-labelledby=\"srv-t\"><div class=\"nm-wrap\"><p class=\"nm-eye\">Servizi</p><h2 class=\"nm-h2\" id=\"srv-t\">Tutto quello che serve a una compravendita</h2><p class=\"nm-lead\">Dalla stima alla consegna delle chiavi, ogni passaggio seguito da professionisti.</p><div class=\"nm-svcs\" style=\"margin-top:2.5rem\"><div class=\"nm-svc\"><h3>Compravendita</h3><p>Ricerca, visite, trattativa e assistenza fino al rogito.</p></div><div class=\"nm-svc\"><h3>Valutazione gratuita</h3><p>Stima ragionata del valore, basata su zona, stato e mercato.</p></div><div class=\"nm-svc\"><h3>Locazioni</h3><p>Contratti di locazione, anche transitori, con gestione completa.</p></div><div class=\"nm-svc\"><h3>Mutui e finanziamenti</h3><p>Consulenza con mediatore creditizio e verifica di fattibilit&agrave;.</p></div><div class=\"nm-svc\"><h3>Home staging</h3><p>Preparazione della casa per mostrarla al meglio e venderla prima.</p></div><div class=\"nm-svc\"><h3>Foto e virtual tour</h3><p>Servizio fotografico professionale, video e tour virtuale.</p></div><div class=\"nm-svc\"><h3>Consulenza legale e notarile</h3><p>Verifica documenti, proposte, preliminari e rapporto con il notaio.</p></div><div class=\"nm-svc\"><h3>Pratiche catastali e APE</h3><p>Visure, planimetrie, conformit&agrave; e attestato di prestazione energetica.</p></div><div class=\"nm-svc\"><h3>Ristrutturazioni</h3><p>Progetti e preventivi con professionisti di fiducia.</p></div></div></div></section>"
    },
    {
        "id": "vendi",
        "nome": "Vendi",
        "enabled": true,
        "html": "<section class=\"nm-sec\" id=\"vendi\" aria-labelledby=\"vnd-t\"><div class=\"nm-wrap nm-2col\"><div><p class=\"nm-eye\">Vendi con noi</p><h2 class=\"nm-h2\" id=\"vnd-t\">Quanto vale la tua casa?</h2><p class=\"nm-lead\">Ti diamo una valutazione gratuita e un piano di vendita chiaro: prezzo, tempi, promozione e visite.</p><ul class=\"nm-list\"><li><b>Stima realistica</b> basata sui prezzi effettivi di zona.</li><li><b>Promozione curata</b> con foto professionali e annunci sui principali portali.</li><li><b>Visite selezionate</b>, solo con acquirenti qualificati.</li><li><b>Assistenza fino al rogito</b>, documenti compresi.</li></ul><p style=\"margin-top:1.75rem\"><a class=\"nm-btn nm-btn-n\" href=\"__BASEURL__/vendi/\">Richiedi la valutazione</a></p></div><img class=\"nm-img\" src=\"__BASEURL__/assets/foto/agenzia/casa-moderna.jpg\" width=\"1400\" height=\"933\" loading=\"lazy\" alt=\"Casa con piscina e giardino\"></div></section>"
    },
    {
        "id": "mutui",
        "nome": "Mutui",
        "enabled": true,
        "html": "<section class=\"nm-sec nm-warm\" id=\"mutui\" aria-labelledby=\"mut-t\"><div class=\"nm-wrap nm-2col\"><img class=\"nm-img\" src=\"__BASEURL__/assets/foto/agenzia/chiavi-rogito.jpg\" width=\"1400\" height=\"935\" loading=\"lazy\" alt=\"Chiavi di casa e modellino\"><div><p class=\"nm-eye\">Mutui</p><h2 class=\"nm-h2\" id=\"mut-t\">Il mutuo giusto, prima di scegliere la casa</h2><p class=\"nm-lead\">Con un mediatore creditizio verifichi quanto puoi chiedere e confronti le offerte delle banche prima di fare una proposta.</p><ul class=\"nm-list\"><li><b>Prequalifica</b> sulla tua situazione reddituale.</li><li><b>Confronto</b> tra tasso fisso, variabile e misto.</li><li><b>Pratica seguita</b> fino all'erogazione.</li></ul><p style=\"margin-top:1.75rem\"><a class=\"nm-btn nm-btn-n\" href=\"__BASEURL__/contatti/\">Parla con un consulente</a></p></div></div></section>"
    },
    {
        "id": "metodo",
        "nome": "Come lavoriamo",
        "enabled": true,
        "html": "<section class=\"nm-sec\" id=\"metodo\" aria-labelledby=\"met-t\"><div class=\"nm-wrap\"><p class=\"nm-eye\">Come lavoriamo</p><h2 class=\"nm-h2\" id=\"met-t\">Quattro passaggi, un solo referente</h2><ol class=\"nm-steps\"><li><b>Ascolto</b><span>Capiamo che cosa cerchi o vuoi vendere.</span></li><li><b>Strategia</b><span>Prezzo, tempi e canali di promozione.</span></li><li><b>Trattativa</b><span>Visite, proposte e negoziazione.</span></li><li><b>Rogito</b><span>Documenti, notaio e consegna delle chiavi.</span></li></ol></div></section>"
    },
    {
        "id": "zone",
        "nome": "Zone",
        "enabled": true,
        "html": "<section class=\"nm-sec nm-warm\" id=\"zone\" aria-labelledby=\"zon-t\"><div class=\"nm-wrap\"><p class=\"nm-eye\">Zone</p><h2 class=\"nm-h2\" id=\"zon-t\">Dove operiamo</h2><div class=\"nm-zone\"><span>Mentana</span><span>Monterotondo</span><span>Fonte Nuova</span><span>Roma nord</span><span>Nomentano</span><span>Sabina</span></div></div></section>"
    },
    {
        "id": "cta",
        "nome": "Contatto",
        "enabled": true,
        "html": "<section class=\"nm-cta\" id=\"contatto\" aria-labelledby=\"cta-t\"><div class=\"nm-cta-in\"><div><h2 class=\"nm-h2\" id=\"cta-t\">Parliamo del tuo immobile</h2><p>Compri, vendi o cerchi in affitto: raccontaci cosa ti serve e ti richiamiamo.</p></div><a class=\"nm-btn nm-btn-w\" href=\"__BASEURL__/contatti/\">Contattaci</a></div></section>"
    },
